rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // O usuário precisa estar autenticado para acessar os dados.
    match /animais/{animalId} {
      allow read, write: if request.auth != null;
      match /manejos/{manejoId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
